  "info": {
    "_postman_id": "68876863-7482-42c5-bc26-8fceb4b51967",
    "name": "Rhizome AI Documents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Search and retrieve regulatory and clinical documents via API. The Rhizome AI API exposes keyword search (BM25 ranking) over regulatory document corpora from health authorities (FDA, EMA, Health Canada, Swissmedic, MHRA, TGA, and others) and full-text page-by-page document retrieval. API access requires an enterprise plan.\n\nContact Support:\n Name: Rhizome AI Support\n Email: support@rhizomeai.com",
      "type": "text/plain"
    }
  }
